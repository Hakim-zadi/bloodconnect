# Copy this file to ".env" (exactly that name, no .txt) and fill in your values.
SMTP_EMAIL=yourgmail@gmail.com
SMTP_PASSWORD=abcdefghijklmnop
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Optional: where the ADMIN signup code is sent (defaults to SMTP_EMAIL)
# ADMIN_CODE_RECEIVER=yourgmail@gmail.com
# Optional: where "Report an issue" messages from the Contact page are sent (defaults to SMTP_EMAIL)
# REPORT_RECEIVER=gabolanmol@gmail.com

# MySQL login (the password you set for MySQL root; leave empty if you have none)
DB_PASSWORD=
# DB_HOST=localhost
# DB_USER=root
# DB_NAME=bloodconnect

# Optional: keep uploaded reports in one fixed folder (recommended on a host with a persistent disk)
# UPLOAD_DIR=C:\BloodConnect_uploads

# Hosting: hosted MySQL port (default 3306)
# DB_PORT=3306
